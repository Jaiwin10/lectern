# ---- Language model (pick one provider) -------------------------------------
# gemini | openai | ollama
LLM_PROVIDER=gemini
# Leave empty for the provider's default (gemini-3-flash-preview, gpt-4.1, qwen3:8b)
LLM_MODEL=
# Optional: a different model for the two QC reviewers
QC_MODEL=

GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Free Gemini keys allow ~5 requests/minute. 0 = no limit.
LLM_REQUESTS_PER_MINUTE=5

# ---- Research (all optional; the tool falls back to free sources) ----------
# Tavily web search, free tier 1,000 searches/month: https://tavily.com
TAVILY_API_KEY=
# One Google Cloud key with "YouTube Data API v3" and "Books API" enabled
GOOGLE_API_KEY=

# ---- Storage ------------------------------------------------------------------
DB_PATH=data/lessons.db
